# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
backend/venv/
*.db
*.db.bak
*.sqlite3
*.log

# Scratch, temporary and backups
scratch/
tmp/
backup/
*_backup.*
*_old.*
backend/models/archive/

# Node
node_modules/
frontend/node_modules/
frontend/dist/
.vite/

# Env (secrets)
.env
.env.local
.env.*.local
frontend/.env
backend/.env

# Keep examples
!.env.example
!frontend/.env.example
!backend/.env.example

# API keys and credentials (ignore credential files only; config files like open_notify.txt and ll2_config.txt remain tracked)
api/*_key*.txt
api/*_token*.txt
api/credentials*.txt
api/gemini_api_key.txt
api/nasa_api_key.txt
!api/*.txt.example

# Keep committed demo fixtures
!demo_fixtures/
!demo_fixtures/**

# Runtime API cache (transient live fetch cache; demo_fixtures/ are committed fixtures)
cache/
!cache/.gitkeep

# Data (large)
data/osdr_i4/
*.zip

# IDE
.vscode/
.idea/
.DS_Store
Thumbs.db

# Internal working documents & local deployment secrets
HANDOFF.md
AGENT_HANDOFF.md
MASTER_PROMPT.md
*.backup.md
*.secrets.md
RENDER_ENVIRONMENT_VARIABLES.md
!RENDER_ENVIRONMENT_VARIABLES.example.md

# Firebase & Cloud Service Accounts (CRITICAL - never commit)
backend/firebase-service-account.json
backend/*-firebase-adminsdk-*.json
backend/serviceAccountKey.json
*-firebase-adminsdk-*.json
credentials.json
*.pem
*.key


